# Copy to .env. Empty secrets are auto-generated (and stored in the data volume) in WALLET_MODE=fake,
# so `docker compose up` works on a clean machine. Live mode (WALLET_MODE=nwc) requires every secret.
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# reverse proxies in front (Railway, nginx: 1); per-visitor rate limits need it
TRUST_PROXY=0
# DATABASE_PATH=          # default: data/ndox.sqlite in the repo; /data/ndox.sqlite in the Docker image

# Keys: 32-byte hex. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# signs announcements + attestations; its x-only pubkey IS the oracle's Nostr pubkey
ORACLE_SECRET=
# replay only, never used for live attestations
DEMO_ORACLE_SECRET=
# signs policy events + payout receipts
POOL_SECRET=

# fake | nwc
WALLET_MODE=fake
# Enrol demo crews on the first start (simulated wallet only); docker compose turns it on.
SEED_DEMO=
# nostr+walletconnect://... (budget-capped connection)
NWC_URL=
# mainnet | mutinynet | regtest | test (test = NWC faucet, sats without value)
NETWORK_LABEL=mainnet
# Test networks only (refused on mainnet): a second NWC wallet that pays invoices when a visitor
# presses "Payer avec le portefeuille de test", and the faucet that creates demo crews' wallets.
TEST_PAYER_NWC_URL=
TEST_FAUCET_URL=https://faucet.nwc.dev
# lud16 on the pool's Nostr profile: sponsors zap it. Must be served by the NWC wallet above
# (e.g. Alby Hub), which confirms every zap before it counts. WALLET_MODE=nwc only.
POOL_LIGHTNING_ADDRESS=
# Most the app pays out per day, in sats (also set a budget on the NWC connection itself).
# Blank: 20000 with WALLET_MODE=nwc, 250000 with the simulated wallet.
DAILY_PAYOUT_CAP_SATS=
RESERVE_FLOOR_SATS=0

NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
# true to publish to relays; false signs but does not publish (dry run)
NOSTR_PUBLISH=false

DEFAULT_THRESHOLD_M=2.5
PAYOUT_FCFA=2000
WAITING_HOURS=72
PREMIUM_LOADING=0.25

# Dashboard login. Generate: printf '%s' 'your passphrase' | pnpm ndox hash-password
# Required with WALLET_MODE=nwc. With WALLET_MODE=fake and no hash, the password is derived
# from SESSION_SECRET: print it with `pnpm ndox admin-password`.
ADMIN_PASSWORD_HASH=
# 32-byte hex
SESSION_SECRET=
# 32-byte hex (AES-256-GCM for phone numbers + Lightning addresses)
PII_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Alternative: an OpenAI key works too (used only when ANTHROPIC_API_KEY is empty).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AT_USERNAME=sandbox
AT_API_KEY=
# Secret the USSD and delivery-report callback URLs must carry as ?token=… (≥ 16 chars).
AT_CALLBACK_TOKEN=
HEALTHCHECK_URL=
