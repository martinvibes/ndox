{
  "name": "ndox",
  "private": true,
  "version": "0.1.0",
  "description": "Quand la mer dit non, Ndox paie. Preventive solidarity for Senegal's artisanal fishers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build",
    "data:fetch": "tsx scripts/data-fetch.ts",
    "backtest": "tsx scripts/backtest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ndox/oracle": "workspace:*",
    "@ndox/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
